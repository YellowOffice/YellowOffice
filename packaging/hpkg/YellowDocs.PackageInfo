# YellowDocs package description (Haiku "package" tool format).
# See: https://www.haiku-os.org/docs/api/packages_building_packages.html
name                  YellowDocs
version               0.1.0-1
architecture          x86_64
summary               "YellowOffice word processor and document editor"
description           "YellowDocs is a word processor for Haiku OS.
It edits rich text with paragraph and character formatting,
and imports/exports the native Yellow Document Format (YDF),
Markdown, plain text, and OpenDocument Text (ODF)."
vendor                "YellowOffice Team"
packager              "YellowOffice Contributors"
copyrights {
      "Copyright (c) 2024 YellowOffice Contributors"
}
licenses {
      "MIT"
}
urls {
      "https://github.com/YellowOffice/YellowOffice"
}
source-urls {
      "https://github.com/YellowOffice/YellowOffice"
}
provides {
      cmd:YellowDocs = 0.1.0
      app:YellowDocs = 0.1.0
}
requires {
      haiku >= r1~beta4
      lib:libbe.so
      lib:libtracker.so
      lib:libz.so
}
